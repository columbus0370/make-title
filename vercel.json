{
  "buildCommand": "flutter build web",
  "outputDirectory": "build/web",
  "framework": "flutter",
  "env": {
    "ANTHROPIC_API_KEY": "@anthropic_api_key"
  },
  "rewrites": [
    {
      "source": "/api/:path*",
      "destination": "/api/:path*"
    },
    {
      "source": "/(.*)",
      "destination": "/index.html"
    }
  ]
}
